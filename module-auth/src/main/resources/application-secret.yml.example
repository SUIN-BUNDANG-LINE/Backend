# auth-service 시크릿 템플릿 — 실제 파일명 application-secret.yml 로 복사해 값을 채운다(git 미추적).
# datasource·oauth2 는 web 의 application-secret.yml 에서 그대로 가져오면 된다.

# JWT 서명키 — 게이트웨이(검증)의 secret 파일과 반드시 같은 값이라야 서명이 성립한다.
jwt:
    secret-key: <JWT_SIGNING_KEY_SAME_AS_GATEWAY>

spring:
    datasource:
        # web·컨슈머와 같은 MySQL(users·refresh_tokens 접근). 컨슈머처럼 슬림 접근.
        url: jdbc:mysql://localhost:3306/sulmun2yong
        username: <DB_USER>
        password: <DB_PASSWORD>
        driver-class-name: com.mysql.cj.jdbc.Driver

    security:
        oauth2:
            client:
                registration:
                    google:
                        client-id: <GOOGLE_CLIENT_ID>
                        client-secret: <GOOGLE_CLIENT_SECRET>
                        redirect-uri: <GOOGLE_REDIRECT_URI>
                        scope:
                            - email
                    kakao:
                        client-id: <KAKAO_CLIENT_ID>
                        client-authentication-method: client_secret_post
                        authorization-grant-type: authorization_code
                        redirect-uri: <KAKAO_REDIRECT_URI>
                        client-name: kakao
                    naver:
                        client-id: <NAVER_CLIENT_ID>
                        client-secret: <NAVER_CLIENT_SECRET>
                        client-authentication-method: client_secret_post
                        authorization-grant-type: authorization_code
                        scope:
                            - mobile
                        redirect-uri: <NAVER_REDIRECT_URI>
                        client-name: naver
                provider:
                    kakao:
                        authorization-uri: https://kauth.kakao.com/oauth/authorize
                        token-uri: https://kauth.kakao.com/oauth/token
                        user-info-uri: https://kapi.kakao.com/v2/user/me
                        user-name-attribute: id
                    naver:
                        authorization-uri: https://nid.naver.com/oauth2.0/authorize
                        token-uri: https://nid.naver.com/oauth2.0/token
                        user-info-uri: https://openapi.naver.com/v1/nid/me
                        user-name-attribute: response
