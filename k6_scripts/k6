#!/usr/bin/env bash
#
# k6 래퍼 — 프로젝트 루트 .env 자동 로드 + Prometheus remote write 자동 부착
#
# 사용:
#   ./k6 run drawing-concurrency.js
#   ./k6 run skip-locked-concurrency.js
#
# .env 자동 로드 변수 (프로젝트 루트):
#   K6_PROMETHEUS_RW_SERVER_URL  Prometheus remote write 수신 URL
#   K6_PROMETHEUS_RW_TREND_STATS Trend 통계 노출 옵션
#   ACCESS_TOKEN                 JWT 토큰 (OAuth2 로그인 후 쿠키 복사)
#   BASE_URL                     백엔드 API URL (web 인스턴스 포트)
#   DB_DSN                       xk6-sql 시나리오용 MySQL DSN
#   GRAFANA_URL / GRAFANA_TOKEN  annotation API (T7)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ENV_FILE="$ROOT_DIR/.env"

# .env 자동 export
if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
fi

# 표준 k6 / xk6-sql 커스텀 바이너리 자동 선택
# 인자 중 xk6-sql 필요 시나리오 이름이 있으면 k6-custom 사용
NEEDS_XK6_SQL=0
for arg in "$@"; do
    case "$arg" in
        *outbox-relay-recovery.js|*outbox-producer-dlq.js|*skip-locked-concurrency.js|*sms-failover.js)
            NEEDS_XK6_SQL=1
            ;;
    esac
done

if [ "$NEEDS_XK6_SQL" -eq 1 ]; then
    K6_BIN="$SCRIPT_DIR/k6-custom"
    if [ ! -x "$K6_BIN" ]; then
        echo "ERROR: $K6_BIN not found. Run xk6 build first." >&2
        exit 1
    fi
else
    K6_BIN="$(command -v k6)"
fi

cd "$SCRIPT_DIR"

exec "$K6_BIN" \
    --out experimental-prometheus-rw \
    --env ACCESS_TOKEN="${ACCESS_TOKEN:-}" \
    --env BASE_URL="${BASE_URL:-http://localhost:18080}" \
    --env DB_DSN="${DB_DSN:-}" \
    --env LOCK_MODE="${LOCK_MODE:-on}" \
    "$@"
