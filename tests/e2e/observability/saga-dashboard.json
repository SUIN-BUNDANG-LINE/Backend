{
  "dashboard": {
    "uid": "sms-saga-obs",
    "title": "SMS 발송-비용 사가 관측",
    "tags": ["saga", "kafka", "cost"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "templating": { "list": [] },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "🚨 멈춘 PENDING 나이(초)",
        "description": "가장 오래된 PENDING 의 나이. 계속 커지면 발송이 확정도 실패도 안 된 채 갇힌 것 — 사가의 1순위 위험.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
        "targets": [ { "expr": "max(cost_oldest_pending_age_seconds)", "refId": "A" } ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 600 }
            ] }
          }, "overrides": []
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "청구액 확정(원)",
        "description": "실제 발송 성공분(CONFIRMED)의 누적 금액. 이것만 과금된다.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
        "targets": [ { "expr": "sum(cost_amount_krw{state=\"CONFIRMED\"})", "refId": "A" } ],
        "fieldConfig": { "defaults": { "unit": "currencyKRW", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
        "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "보상 REVERSED 건수",
        "description": "DLT 도달로 비용이 취소된 건수. 급증하면 상류(SMS 게이트웨이) 이상 신호.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
        "targets": [ { "expr": "sum(cost_records{state=\"REVERSED\"})", "refId": "A" } ],
        "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
        "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "DLT 누적",
        "description": "죽은 편지 큐에 영구 저장된 실패 메시지 총수.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
        "targets": [ { "expr": "sum(dlt_messages)", "refId": "A" } ],
        "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
        "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "사가 상태별 건수 (PENDING / CONFIRMED / REVERSED)",
        "description": "비용 레코드의 상태 분포 추이. PENDING 이 안 줄면 멈춘 사가, REVERSED 상승은 보상 발생.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
        "targets": [ { "expr": "sum by (state) (cost_records)", "legendFormat": "{{state}}", "refId": "A" } ],
        "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } } }, "overrides": [] },
        "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } }
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "멈춘 PENDING 나이 추이(초)",
        "description": "이 선이 우상향으로 계속 오르면 사가가 수렴하지 못하고 갇힌 것. 보상 경로(~5분) 이상으로 길어지면 조사.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
        "targets": [ { "expr": "max(cost_oldest_pending_age_seconds)", "legendFormat": "oldest PENDING age", "refId": "A" } ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "drawStyle": "line", "fillOpacity": 10 },
            "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 600 } ] }
          }, "overrides": []
        },
        "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
      }
    ]
  },
  "overwrite": true
}
