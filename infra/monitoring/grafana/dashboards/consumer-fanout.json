                        "properties": [
                            {"id": "color", "value": {"mode": "fixed", "fixedColor": "white"}},
                            {"id": "custom.lineWidth", "value": 3}
                        ]
                    }
                ]
            },
            "options": {
                "legend": {"calcs": ["last", "max"], "displayMode": "table", "placement": "right", "showLegend": true},
                "tooltip": {"mode": "multi", "sort": "desc"}
            }
        },
        {
            "type": "timeseries",
            "id": 6,
            "title": "Topic: drawing-notification.DLT — Produced vs Consumed (rate, by group)",
            "description": "DLT 토픽 — 재시도 초과 메시지 영속화 경로. produced는 0이 정상(DLT로 빠지는 메시지 없음이 정상 상태). produced > 0이면 SMS 발송 실패 누적 발생 — sms-failover 대시보드 + Kafka UI에서 메시지 본문 확인.",
            "gridPos": {"h": 8, "w": 24, "x": 0, "y": 35},
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "targets": [
                {
                    "expr": "sum (rate(kafka_topic_partition_current_offset{topic=\"drawing-notification.DLT\"}[1m]))",
